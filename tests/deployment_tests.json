          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test successful blog retrieval",
                  "pm.test(\"Blogs retrieved successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    ",
                  "    // Test blog structure",
                  "    if (jsonData.length > 0) {",
                  "        var blog = jsonData[0];",
                  "        pm.expect(blog).to.have.property('post_id');",
                  "        pm.expect(blog).to.have.property('title');",
                  "        pm.expect(blog).to.have.property('content');",
                  "        pm.expect(blog).to.have.property('author');",
                  "        pm.expect(blog).to.have.property('created_at');",
                  "    }",
                  "});",
                  "",
                  "// Test pagination",
                  "pm.test(\"Pagination works correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.at.most(10);",
                  "});",
                  "",
                  "// Test sorting",
                  "pm.test(\"Blogs are sorted by date\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 1) {",
                  "        var firstDate = new Date(jsonData[0].created_at);",
                  "        var secondDate = new Date(jsonData[1].created_at);",
                  "        pm.expect(firstDate >= secondDate).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
