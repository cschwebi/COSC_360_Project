    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "testuser",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "testpass",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/php_func/login.php",
              "host": [ "{{base_url}}" ],
              "path": [ "php_func", "login.php" ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test successful login",
                  "pm.test(\"Login successful with valid credentials\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(\"success\");",
                  "    pm.expect(jsonData.message).to.equal(\"Login successful\");",
                  "    pm.expect(jsonData).to.have.property('user_id');",
                  "    pm.expect(jsonData).to.have.property('username');",
                  "    ",
                  "    // Store user data for other requests",
                  "    if (jsonData.user_id) {",
                  "        pm.environment.set(\"user_id\", jsonData.user_id);",
                  "        pm.environment.set(\"username\", jsonData.username);",
                  "    }",
                  "});",
                  "",
                  "// Test failed login",
                  "pm.test(\"Login fails with invalid credentials\", function () {",
                  "    if (pm.response.code === 401) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.status).to.equal(\"error\");",
                  "        pm.expect(jsonData.message).to.equal(\"Invalid username or password\");",
                  "    }",
                  "});",
                  "",
                  "// Test input validation",
                  "pm.test(\"Login validates required fields\", function () {",
                  "    if (pm.response.code === 400) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.status).to.equal(\"error\");",
                  "        pm.expect(jsonData.message).to.include(\"required\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
