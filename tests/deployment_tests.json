                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Test Blog Post",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "This is a test blog post content",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/php_func/createPost.php",
              "host": [ "{{base_url}}" ],
              "path": [ "php_func", "createPost.php" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test successful post creation",
                  "pm.test(\"Post creation successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(\"success\");",
                  "    pm.expect(jsonData).to.have.property('post_id');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    ",
                  "    // Store post ID for other requests",
                  "    if (jsonData.post_id) {",
                  "        pm.environment.set(\"post_id\", jsonData.post_id);",
                  "    }",
                  "});",
                  "",
                  "// Test image upload",
                  "pm.test(\"Image upload successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.image_url) {",
                  "        pm.expect(jsonData.image_url).to.match(/^\\/uploads\\/.*\\.(jpg|jpeg|png|gif)$/i);",
                  "    }",
                  "});",
                  "",
                  "// Test content validation",
                  "pm.test(\"Content validation\", function () {",
                  "    if (pm.response.code === 400) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.status).to.equal(\"error\");",
                  "        pm.expect(jsonData.message).to.include(\"content\");",
                  "    }",
                  "});",
                  "",
                  "// Test file type validation",
                  "pm.test(\"File type validation\", function () {",
                  "    if (pm.response.code === 400) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.status).to.equal(\"error\");",
                  "        pm.expect(jsonData.message).to.include(\"file type\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Blogs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/php_func/get_blogs.php",
              "host": [ "{{base_url}}" ],
